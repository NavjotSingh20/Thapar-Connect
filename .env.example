# ==============================================================================
# Thapar Connect - Environment Configuration Template
# Copy this file to .env before starting the application
# ==============================================================================

# --- Database (PostgreSQL 16) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=thapar_connect
DB_USER=postgres
DB_PASSWORD=postgres

# --- Backend Application (Spring Boot 3.3.x) ---
SERVER_PORT=8080
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Authentication & Security ---
# Secret key for HMAC-SHA256 JWT signing (minimum 256 bits / 32 characters)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Access token expiration: 15 minutes (in milliseconds: 15 * 60 * 1000)
JWT_ACCESS_EXPIRATION_MS=900000
# Refresh token cookie expiration: 7 days (in milliseconds: 7 * 24 * 60 * 60 * 1000)
JWT_REFRESH_EXPIRATION_MS=604800000
# Secure cookie flag (set to true when running behind HTTPS in production)
APP_COOKIE_SECURE=false

# Google OAuth2 Client ID (must verify tokens ending with @thapar.edu)
GOOGLE_CLIENT_ID=mock-google-client-id.apps.googleusercontent.com
# Set to true to allow mock tokens in local automated dev/test environments
ALLOW_MOCK_TOKENS=false

# CORS Allowed Origins (comma-separated list of browser origins)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost

# --- Pluggable Storage Service ---
# Storage provider: LOCAL, S3, or CLOUDINARY (defaults to LOCAL for dev)
STORAGE_PROVIDER=LOCAL
STORAGE_LOCAL_DIR=uploads
STORAGE_BASE_URL=/api/v1/storage
# Cloudinary (optional for production deployments)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Frontend (Vite / React) ---
FRONTEND_PORT=3000
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=/ws
VITE_GOOGLE_CLIENT_ID=mock-google-client-id.apps.googleusercontent.com
